+namespace envelope_detail {
+// Non-signaling ordered comparisons, equivalent to std::islessequal / std::isgreaterequal
+// (ordered, quiet on QNaN, false when unordered). MSVC (unlike Clang and GCC) does not lower
+// those std functions to the UCOMISD instruction; it calls the out-of-line UCRT helper _dpcomp()
+// instead, which makes Envelope intersection tests ~2-3x slower. _mm_ucomige_sd is UCOMISD and
+// gives identical semantics in a single instruction. Every other compiler keeps the std form.
+#if defined(_MSC_VER) && !defined(__clang__)
+inline bool quietLessEqual(double a, double b)    { return _mm_ucomige_sd(_mm_set_sd(b), _mm_set_sd(a)) != 0; }
+inline bool quietGreaterEqual(double a, double b) { return _mm_ucomige_sd(_mm_set_sd(a), _mm_set_sd(b)) != 0; }
+#else
+inline bool quietLessEqual(double a, double b)    { return std::islessequal(a, b); }
+inline bool quietGreaterEqual(double a, double b) { return std::isgreaterequal(a, b); }
+#endif
+} // namespace envelope_detail
+
